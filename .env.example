APP_NAME=PanDev
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pandev_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=5
SESSION_IDLE_WARNING=60
SESSION_ENCRYPT=false
# Set true di produksi (HTTPS): cookie sesi hanya dikirim lewat HTTPS.
SESSION_SECURE_COOKIE=

# Prefix rahasia area admin (login + dashboard) — kombinasi angka, mis. 42904104.
# Kosong = nonaktif, route kembali ke /login dan /dashboard.
ADMIN_PATH=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@pandev.test"
MAIL_FROM_NAME="${APP_NAME}"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

WEB3FORMS_ACCESS_KEY=

WHATSAPP_NUMBER=

# --- SEO ---------------------------------------------------------------
# Token verifikasi Search Console (metode "HTML tag"). Kosong = meta tidak
# dirender, jadi tidak ada tag sampah di lokal.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Teks default bila halaman tidak mengisi section title/description.
SEO_DEFAULT_TITLE=
SEO_DEFAULT_DESCRIPTION=
SEO_KEYWORDS=

# Gambar fallback untuk kartu pratinjau (boleh path lokal atau URL absolut).
SEO_IMAGE=
SEO_TWITTER=
SEO_LOCALE=id_ID
SEO_THEME_COLOR=#ffffff

# Data schema.org/Organization (alamat opsional, isi bila kantor sudah pasti).
SEO_ORG_NAME=
SEO_ORG_EMAIL=
SEO_ORG_PHONE=
SEO_ORG_STREET=
SEO_ORG_CITY=
SEO_ORG_REGION=
SEO_ORG_COUNTRY=ID
SEO_ORG_LOGO=

VITE_APP_NAME="${APP_NAME}"
